# Copy to hub/.env (never committed). Variables already set in the environment win.
# Leave both empty to run the hub on demo data.

# Where Home Assistant answers, e.g. http://homeassistant.local:8123
AETHER_HA_URL=

# A long-lived access token: Home Assistant → your profile → Security.
AETHER_HA_TOKEN=

# Optional: the entities file, relative to hub/. Default: aether.toml
# AETHER_CONFIG=aether.toml
